# Eval-сьюта скиллов: сырые прогоны не коммитятся.
# Исключение — только сводные базлайны вида baseline-<версия>-<модель>,
# по которым сравниваются последующие замеры.
.claude/evals/*/runs/*
!.claude/evals/*/runs/baseline-[0-9]*

# Локальные настройки доступа: содержат абсолютные пути конкретной машины
.claude/settings.json
